{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "restore",
      "type": "process",
      "command": "dotnet",
      "args": ["restore", "OptimizedFlange.sln"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "OptimizedFlange.sln", "--configuration", "Debug"],
      "dependsOn": "restore",
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build-release",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "OptimizedFlange.sln", "--configuration", "Release"],
      "dependsOn": "restore",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "OptimizedFlange.sln", "--configuration", "Debug"],
      "problemMatcher": "$msCompile"
    }
  ]
}
