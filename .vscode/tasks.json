{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "restore",
      "type": "process",
      "command": "dotnet",
      "args": [
        "restore",
        "OptimizedFlange.sln"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "OptimizedFlange.sln",
        "--configuration",
        "Debug"
      ],
      "dependsOn": "restore",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-release",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "OptimizedFlange.sln",
        "--configuration",
        "Release"
      ],
      "dependsOn": "restore",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "OptimizedFlange.sln",
        "--configuration",
        "Debug",
        "--no-restore"
      ],
      "dependsOn": "restore",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "run-text-demo",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "examples/OptimizedFlange.TextDemo/OptimizedFlange.TextDemo.fsproj",
        "--configuration",
        "Debug"
      ],
      "dependsOn": "restore",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "OptimizedFlange.sln",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test-validation",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "tests/OptimizedFlange.ValidationTests/OptimizedFlange.ValidationTests.fsproj",
        "--configuration",
        "Debug"
      ],
      "dependsOn": "restore",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "package",
      "type": "process",
      "command": "dotnet",
      "args": [
        "pack",
        "OptimizedFlange.sln",
        "--configuration",
        "Release",
        "--no-build"
      ],
      "dependsOn": "build-release",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish-nuget-dry-run",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/publish-nuget.ps1"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
